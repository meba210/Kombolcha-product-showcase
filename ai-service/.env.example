# Production source of truth: use the same MySQL database configured for Express.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3307/factory_platform
AI_DATA_SOURCE=mysql
PORT=8000
LOG_LEVEL=INFO

# Local development and tests only. The supplied CSV contains estimated prices
# and stock and is not a source for customer-facing product data.
# AI_DATA_SOURCE=csv
# PRODUCTS_CSV_PATH=./data/kombolcha_factories_products_500.csv

# Hybrid scoring weights are normalized before use; both must not be zero.
E5_WEIGHT=0.70
TFIDF_WEIGHT=0.30
RECOMMENDATION_TOP_N=8

# Keep CPU memory use predictable on smaller Windows PCs.
E5_CPU_THREADS=2
